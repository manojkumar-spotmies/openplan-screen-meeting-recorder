{
  "manifest_version": 3,
  "name": "Openplan Screen & Meeting Recorder",
  "version": "1.1.0",
  "description": "Local-first screen and meeting recorder extension for Openplan.",
  "permissions": [
    "offscreen",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Openplan Recorder"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/content/meet-detector.ts"
      ]
    }
  ]
}