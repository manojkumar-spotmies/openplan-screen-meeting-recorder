{
  "manifest_version": 3,
  "name": "Openplan Screen & Meeting Recorder",
  "version": "1.1.0",
  "description": "Local-first screen and meeting recorder extension for Openplan.",
  "permissions": [
    "offscreen",
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Openplan Recorder"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/content/meet-detector.ts"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/recording-widget.tsx"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://*.openplan.ai/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/recording-widget.js",
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}